{{- $remote := or (env "CODESPACES" | not | not) (env "SSH_CONNECTION" | not | not) (env "KUBERNETES_SERVICE_HOST" | not | not) (env "container" | not | not) (env "REMOTE_CONTAINERS" | not | not) (stat "/.dockerenv" | not | not) -}}

set -o vi

# edit PATH
if [[ -d $HOME/.local/bin ]]; then
  export PATH=$HOME/.local/bin:$PATH
fi

{{if not $remote -}}
# SSH agent: préférer Pageant (WSL bridge) si présent, sinon gpg-agent / ssh-agent
if [[ -S "$HOME/.ssh/wsl-ssh-agent.sock" ]]; then
  export SSH_AUTH_SOCK="$HOME/.ssh/wsl-ssh-agent.sock"
else
  unset SSH_AGENT_PID
  if [ "${gnupg_SSH_AUTH_SOCK_by:-0}" -ne $$ ]; then
    export SSH_AUTH_SOCK="$(gpgconf --list-dirs agent-ssh-socket)"
  fi

  # fallback to ssh-agent when gpg-agent is not available
  SSH_AGENT_CONF="$HOME/.ssh/agent"
  if [ -e "$SSH_AGENT_CONF" ]; then
    . "$SSH_AGENT_CONF" > /dev/null
  fi
  if ! ssh-add -l >/dev/null 2>&1; then
    ssh-agent > "$SSH_AGENT_CONF"
    if [ $? -ne 0 ]; then
      echo "ERROR: Could not launch ssh-agent" >&2
    fi
    . "$SSH_AGENT_CONF" > /dev/null
    ssh-add
  fi
fi
{{- end}}

if command -v mise >/dev/null; then
  eval "$(mise activate bash)"
fi

# (neo)vim
if command -v nvim > /dev/null ; then
  export EDITOR="nvim"
  export VISUAL="nvim"
elif command -v vim > /dev/null ; then
  export EDITOR="vim"
  export VISUAL="vim"
fi

# enable the starship prompt
if command -v starship >/dev/null; then
  eval "$(starship init bash)"
fi

# Load custom aliases if present
if [[ -f $HOME/.bash/aliases.bash ]]; then
  source $HOME/.bash/aliases.bash
fi

# Load git completion
if [[ -f $HOME/.bash/git-completion.bash ]]; then
  source $HOME/.bash/git-completion.bash
fi

# Load orange bashrc if present
if [[ -f $HOME/.bashrc.orange ]]; then
  source $HOME/.bashrc.orange
fi

# Load kubectl and helm completions if available
if command -v kubectl >/dev/null 2>&1; then
  # shellcheck source=/usr/bin/kubectl
  source <(kubectl completion bash)
  complete -F __start_kubectl k
fi

if command -v helm >/dev/null 2>&1; then
  # shellcheck source=/usr/bin/helm
  source <(helm completion bash)
fi

# use bat instead of c
if command -v bat >/dev/null; then
  alias c="bat"
fi

if [ -f "$HOME/.venv/bin/activate" ]; then
  . "$HOME/.venv/bin/activate"
fi

# Added by wsl2-ssh-pageant-bridge installer (réaffirmé après le reste du bashrc)
if [[ -S "$HOME/.ssh/wsl-ssh-agent.sock" ]]; then
  export SSH_AUTH_SOCK="$HOME/.ssh/wsl-ssh-agent.sock"
fi

# BEGIN WSL2 SSH PAGEANT BRIDGE BASHRC
# In tmux interactive shells, load centralized ssh wrapper function
if [ -n "$TMUX" ] && [ -f "$HOME/.bash/tmux-bash-env.bash" ]; then
  . "$HOME/.bash/tmux-bash-env.bash"
fi
# END WSL2 SSH PAGEANT BRIDGE BASHRC

# Bash completion (core)
if ! shopt -oq posix; then
  if [ -r /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -r /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

gitfind() {
    if [ $# -eq 0 ]; then
        # Pas d'argument → cherche dans . (courant)
        find . -type d -name ".git" -prune -exec dirname {} \;
    else
        # 1+ arguments → cherche dans dossier(s) donné(s)
        find "$@" -type d -name ".git" -prune -exec dirname {} \;
    fi
}
