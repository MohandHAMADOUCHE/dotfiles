#!/usr/bin/env python3
"""Dedupe ~/.bash_history (keep last occurrence). Safe with #timestamp lines."""
import re
from pathlib import Path

p = Path.home() / ".bash_history"
raw = p.read_text(errors="replace").splitlines()
entries = []
i = 0
while i < len(raw):
    line = raw[i]
    if re.fullmatch(r"#\d+", line.strip()):
        if i + 1 < len(raw):
            entries.append(raw[i + 1].rstrip())
            i += 2
        else:
            i += 1
    else:
        if line.strip():
            entries.append(line.rstrip())
        i += 1
seen, out_rev = set(), []
for cmd in reversed(entries):
    key = cmd.strip()
    if key in seen:
        continue
    seen.add(key)
    out_rev.append(cmd)
out = list(reversed(out_rev))
p.write_text("\n".join(out) + ("\n" if out else ""))
print(f"{len(entries)} -> {len(out)}")
